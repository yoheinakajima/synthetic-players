  {
   "id": "R1-persona-composition",
   "statement": "persona system = preamble + \"\\n\\n\" + sealed bare system, byte-identical; persona sha pinned in arms manifest and re-verified per request",
   "layers": {
    "dispatch": {
     "file": "../../artifacts/api-server/engine/phase5_runner.py",
     "pattern": "compose_persona_system\\(llm_cfg\\[\\\"personaPreamble\\\"\\], system\\)"
    },
    "enforcement": {
     "file": "../../artifacts/api-server/engine/phase5.py",
     "pattern": "R1-persona-composition: arm .* pins persona sha"
    },
    "replay": {
     "file": "../../artifacts/api-server/engine/phase5_runner.py",
     "pattern": "R1 replay mirror: re-fetch the persona from the SEALED store"
    }
   }
  },
  {
   "id": "R2-per-T-echo",
   "statement": "request body temperature field must equal the arm's pinned temperature on every call, asserted before dispatch",
   "layers": {
    "dispatch": {
     "file": "../../artifacts/api-server/engine/phase5_driver.py",
     "pattern": "\\\"temperature\\\": float\\(arm\\[\\\"temperature\\\"\\]\\)"
    },
    "enforcement": {
     "file": "../../artifacts/api-server/engine/phase5.py",
     "pattern": "def assert_temperature_echo\\("
    },
    "replay": {
     "file": "../../artifacts/api-server/engine/phase5_runner.py",
     "pattern": "R2: recorded temperature"
    }
   }
  },
  {
   "id": "R3-revision-pin",
   "statement": "returned model revision string must equal the registered pin; mismatch aborts (response archived, spend kept)",
   "layers": {
    "dispatch": {
     "file": "../../artifacts/api-server/engine/phase5_runner.py",
     "pattern": "assert_revision_pin\\(llm_cfg\\[\\\"model\\\"\\], response\\.to_dict\\(\\)\\.get\\(\\\"model\\\"\\)\\)"
    },
    "enforcement": {
     "file": "../../artifacts/api-server/engine/phase5.py",
     "pattern": "def assert_revision_pin\\("
    },
    "replay": {
     "file": "../../artifacts/api-server/engine/phase5_runner.py",
     "pattern": "R3: recorded returned model"
    }
   }
  },
  {
   "id": "sentinel-attestation-gate",
   "statement": "dispatch past a sentinel check requires a POSITIVE evaluator attestation; absence of evaluation fail-closes",
